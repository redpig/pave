{
  "name": "parcels",
  "version": 1,
  "doc": "Packages handed from courier to courier, each handoff a transfer with a receipt, until the addressee retires the parcel. Covers spec/parcels.md's signed delivery, dispatch gating and void tokens after a remint; reminting itself, codes and drops stay in the profile's code for now.",
  "schemas": {
    "parcel": {
      "meaning": "A package in someone's custody. Its origin is the parcel's id; whoever holds it has the package.",
      "schema": { "label": "parcel", "divisible": false, "soft_expiry": null, "hard_expiry": null, "offline_transfers": 32, "max_per_holder": null, "sequence": null }
    }
  },
  "layouts": {
    "manifest": {
      "domain": "pave/parcel/manifest",
      "fields": [
        { "name": "parcel", "type": "hash", "doc": "The parcel token's origin" },
        { "name": "what", "type": "text" },
        { "name": "from_cell", "type": "text", "doc": "A coarse location cell" },
        { "name": "to_cell", "type": "text" },
        { "name": "addressee", "type": "credential", "doc": "Who may confirm delivery" },
        { "name": "pay_per_hop", "type": "u64" },
        { "name": "mode", "type": "any", "default": "Signed", "doc": "How delivery is shown: \"Signed\" here" },
        { "name": "provider", "type": { "opt": "credential" } },
        { "name": "label", "type": { "opt": "hash" }, "doc": "The hash of the code on the package's label" },
        { "name": "dispatch", "type": { "opt": "any" } },
        { "name": "replaces", "type": { "opt": "hash" } },
        { "name": "lineage", "type": { "opt": "hash" }, "doc": "The lineage coin the shipper keeps" },
        { "name": "generation", "type": "u32", "default": 0 }
      ]
    }
  },
  "receipts": {
    "handoff": { "domain": "pave/parcel/handoff", "parts": [ { "hash": { "layout": "manifest", "of": { "param": "manifest" } } }, "hop" ] },
    "take": { "domain": "pave/parcel/take", "parts": [ { "hash": { "layout": "manifest", "of": { "param": "manifest" } } }, "hop" ] },
    "shipping": { "domain": "pave/parcel/shipping", "parts": [ { "param": "parcel" } ] },
    "pay": { "domain": "pave/parcel/pay", "parts": [ { "param": "parcel" }, { "param": "courier" } ] }
  },
  "actions": {
    "mint": {
      "doc": "Shipper: mint a parcel coin to a fresh key from the parcel budget. Shipping mints two: the token that travels, and the lineage coin the shipper keeps; then build the manifest.",
      "state": { "budget": { "schema": "parcel" } },
      "op": { "mint": { "to": "fresh" } }
    },
    "hand_off": {
      "doc": "Give the parcel to the next courier's key, committing to the manifest and the hop. If the manifest names a dispatch, that key must hold its shift ticket, unless it is the addressee's.",
      "state": { "held": { "origin": { "field": { "of": { "param": "manifest" }, "name": "parcel" } } } },
      "requires": [
        { "if_present": { "value": { "field": { "of": { "param": "manifest" }, "name": "dispatch" } }, "then": { "any_of": [
          { "equal": [ { "param": "to" }, { "field": { "of": { "param": "manifest" }, "name": "addressee" } } ] },
          { "ticket_from": { "key": { "param": "to" }, "clerk": { "field": { "of": { "field": { "of": { "param": "manifest" }, "name": "dispatch" } }, "name": "clerk" } }, "sequence": { "field": { "of": { "field": { "of": { "param": "manifest" }, "name": "dispatch" } }, "name": "id" } } } }
        ] } } }
      ],
      "op": { "transfer": { "to": { "param": "to" }, "receipt": "handoff" } },
      "hop": 1
    },
    "take": {
      "doc": "Courier: take a parcel handed to you: check the handoff matches the manifest, the token isn't void (its lineage hasn't moved past it), and the coin passes the acceptance check with the dispatch's clerk also trusted; then move it to a fresh key, or a shift key if dispatched.",
      "state": { "held": { "origin": { "field": { "of": { "param": "manifest" }, "name": "parcel" } } } },
      "requires": [
        { "created_with": { "receipt": "handoff" } },
        { "if_present": { "value": { "field": { "of": { "param": "manifest" }, "name": "lineage" } }, "then": { "lineage_current": { "lineage": { "field": { "of": { "param": "manifest" }, "name": "lineage" } }, "generation": { "field": { "of": { "param": "manifest" }, "name": "generation" } } } } } }
      ],
      "check": true,
      "trust": [ { "clerk": { "field": { "of": { "field": { "of": { "param": "manifest" }, "name": "dispatch" } }, "name": "clerk" } }, "sequence": { "field": { "of": { "field": { "of": { "param": "manifest" }, "name": "dispatch" } }, "name": "id" } } } ],
      "op": { "transfer": { "to": { "key_from": { "clerk": { "field": { "of": { "field": { "of": { "param": "manifest" }, "name": "dispatch" } }, "name": "clerk" } }, "sequence": { "field": { "of": { "field": { "of": { "param": "manifest" }, "name": "dispatch" } }, "name": "id" } } } }, "receipt": "take" } },
      "hop": 1
    },
    "confirm": {
      "doc": "Addressee: confirm delivery by retiring the parcel.",
      "state": { "held": { "origin": { "field": { "of": { "param": "manifest" }, "name": "parcel" } } } },
      "requires": [ { "holder_is": { "field": { "of": { "param": "manifest" }, "name": "addressee" } } } ],
      "op": "retire"
    }
  },
  "walks": {
    "custody": {
      "from": { "field": { "of": { "param": "manifest" }, "name": "parcel" } },
      "steps": [ { "receipt": "handoff", "label": "handoff" }, { "receipt": "take", "label": "take" } ],
      "retire": "retired"
    }
  }
}
